{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/capitalone/vulnhunter/assignment.schema.json",
  "title": "VulnHunter model assignment",
  "type": "object",
  "required": [
    "assignment_id", "kind", "model_alias", "provider", "model",
    "status", "usage", "prompt_hash"
  ],
  "properties": {
    "assignment_id": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "threat_model", "hunt", "specialist", "seed_review",
        "clean_challenge", "sweep", "review", "validate",
        "attack_path", "resolve"
      ]
    },
    "model_alias": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "partition_id": {"type": "string"},
    "files": {"type": "array", "items": {"type": "string"}},
    "candidate_id": {"type": "string"},
    "specialist_profile": {"type": "string"},
    "prompt_hash": {"type": "string"},
    "status": {"enum": ["PENDING", "COMPLETED", "FAILED"]},
    "error": {"type": "string"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens", "output_tokens", "cached_input_tokens",
        "cache_write_tokens", "requests", "rate_limit_retries",
        "cost_usd", "cost_source", "duration_seconds"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "cache_write_tokens": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "rate_limit_retries": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "cost_source": {"enum": ["unknown", "provider", "estimate", "mixed"]},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "coverage_quality": {"enum": ["auditable", "self_reported"]},
    "context": {"type": "object"}
  },
  "additionalProperties": false
}
