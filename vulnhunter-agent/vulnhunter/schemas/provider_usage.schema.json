{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/capitalone/vulnhunter/provider_usage.schema.json",
  "title": "VulnHunter provider usage",
  "type": "object",
  "required": ["input_tokens", "output_tokens", "cost_usd", "duration_seconds"],
  "properties": {
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cached_input_tokens": {"type": "integer", "minimum": 0},
    "cache_write_tokens": {"type": "integer", "minimum": 0},
    "requests": {"type": "integer", "minimum": 0},
    "rate_limit_retries": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "cost_source": {"enum": ["unknown", "provider", "estimate", "mixed"]},
    "duration_seconds": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
