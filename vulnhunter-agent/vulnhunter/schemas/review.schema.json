{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/capitalone/vulnhunter/review.schema.json",
  "title": "VulnHunter independent candidate review",
  "type": "object",
  "required": [
    "review_id", "candidate_id", "reviewer", "verdict", "rationale",
    "incorrect_claims", "missing_evidence", "usage"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^CAND-[0-9]{5}$"},
    "reviewer": {"type": "object"},
    "verdict": {"enum": ["CONFIRMED", "REJECTED", "CONDITIONAL", "UNRESOLVED"]},
    "rationale": {"type": "string"},
    "incorrect_claims": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cost_usd", "duration_seconds"]
    }
  },
  "additionalProperties": true
}
